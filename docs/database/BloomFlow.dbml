// BloomFlow — общая ER-диаграмма (этап 4.1)
// Источник: утверждённые заметки этапа 3.1–3.10.
// Целевая СУБД: PostgreSQL. Это схема для dbdiagram.io, НЕ SQL-миграция.
// [increment] визуализирует автогенерацию PK; в Alembic нужен GENERATED AS IDENTITY.
// Частичные индексы и порядок DESC см. в SQL-комментариях у таблиц.

Project BloomFlow {
  database_type: 'PostgreSQL'
  Note: '10 таблиц BloomFlow: пользователи, каталог, корзина, заказы, доставка и платежи.'
}

// 3.1. User — пользователь системы
Table users {
  id bigint [pk, increment, not null]
  telegram_id bigint [not null, unique]
  first_name text [not null]
  last_name text [null]
  phone varchar(32) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// 3.2. Category — категория товаров
Table categories {
  id bigint [pk, increment, not null]
  name text [not null]
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `btrim(name) <> ''`
  }

  indexes {
    `lower(btrim(name))` [unique, name: 'categories_name_normalized_uq']
  }
}

// 3.3. Product — товар магазина
Table products {
  id bigint [pk, increment, not null]
  category_id bigint [not null]
  name text [not null]
  description text [not null]
  composition text [null]
  price numeric(12,2) [not null]
  is_active boolean [not null, default: false]
  is_available boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `btrim(name) <> ''`
    `btrim(description) <> ''`
    `price > 0 AND price <> 'NaN'::numeric`
    `NOT is_available OR is_active`
  }

  indexes {
    category_id [name: 'products_category_id_idx']
  }
}

// 3.4. ProductImage — изображение товара
Table product_images {
  id bigint [pk, increment, not null]
  product_id bigint [not null]
  storage_key text [not null, unique]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `btrim(storage_key) <> ''`
  }

  indexes {
    (product_id, sort_order, id) [name: 'product_images_product_order_idx']
  }
}

// 3.5. Cart — корзина пользователя
Table carts {
  id bigint [pk, increment, not null]
  user_id bigint [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// 3.6. CartItem — позиция корзины
Table cart_items {
  id bigint [pk, increment, not null]
  cart_id bigint [not null]
  product_id bigint [not null]
  quantity integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `quantity > 0`
  }

  indexes {
    (cart_id, product_id) [unique]
    product_id [name: 'cart_items_product_id_idx']
  }
}

// 3.7. Order — заказ покупателя
Table orders {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  checkout_key uuid [not null, unique]
  status varchar(32) [not null, default: 'awaiting_payment']
  items_total numeric(12,2) [not null]
  delivery_price numeric(12,2) [not null]
  total_amount numeric(12,2) [not null]
  buyer_name text [not null]
  buyer_phone varchar(32) [not null]
  comment text [null]
  payment_expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `status IN ('awaiting_payment', 'paid', 'confirmed', 'assembling', 'delivering', 'completed', 'canceled')`
    `items_total > 0 AND items_total <> 'NaN'::numeric`
    `delivery_price >= 0 AND delivery_price <> 'NaN'::numeric`
    `total_amount > 0 AND total_amount <> 'NaN'::numeric AND total_amount = items_total + delivery_price`
    `btrim(buyer_name) <> ''`
    `btrim(buyer_phone) <> ''`
    `payment_expires_at > created_at`
  }

  indexes {
    // В PostgreSQL: (user_id, created_at DESC, id DESC).
    (user_id, created_at, id) [name: 'orders_user_created_idx', note: 'В миграции: created_at DESC, id DESC']
  }

  // Частичный индекс PostgreSQL: DBML не передаёт предикат WHERE.
  // CREATE INDEX orders_awaiting_payment_expires_idx
  // ON orders (payment_expires_at) WHERE status = 'awaiting_payment';
}

// 3.8. OrderItem — позиция оформленного заказа
Table order_items {
  id bigint [pk, increment, not null]
  order_id bigint [not null]
  product_id bigint [not null]
  product_name text [not null]
  product_description text [not null]
  product_composition text [null]
  unit_price numeric(12,2) [not null]
  quantity integer [not null]
  line_total numeric(12,2) [not null]

  checks {
    `btrim(product_name) <> ''`
    `btrim(product_description) <> ''`
    `unit_price > 0 AND unit_price <> 'NaN'::numeric`
    `quantity > 0`
    `line_total > 0 AND line_total <> 'NaN'::numeric AND line_total = unit_price * quantity`
  }

  indexes {
    (order_id, product_id) [unique]
    product_id [name: 'order_items_product_id_idx']
  }
}

// 3.9. Delivery — доставка заказа
Table deliveries {
  id bigint [pk, increment, not null]
  order_id bigint [not null, unique]
  recipient_name text [not null]
  recipient_phone varchar(32) [not null]
  address_text text [not null]
  delivery_window_start_at timestamptz [not null]
  delivery_window_end_at timestamptz [not null]
  courier_instructions text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `btrim(recipient_name) <> ''`
    `btrim(recipient_phone) <> ''`
    `btrim(address_text) <> ''`
    `delivery_window_end_at > delivery_window_start_at`
  }
}

// 3.10. Payment — попытка онлайн-оплаты заказа
Table payments {
  id bigint [pk, increment, not null]
  order_id bigint [not null]
  provider varchar(32) [not null]
  provider_payment_id text [null]
  idempotency_key uuid [not null, unique]
  amount numeric(12,2) [not null]
  currency varchar(3) [not null, default: 'RUB']
  status varchar(32) [not null, default: 'created']
  payment_url text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  paid_at timestamptz [null]

  checks {
    `btrim(provider) <> ''`
    `amount > 0 AND amount <> 'NaN'::numeric`
    `currency = 'RUB'`
    `status IN ('created', 'pending', 'succeeded', 'failed', 'canceled')`
    `(status = 'succeeded') = (paid_at IS NOT NULL)`
  }

  indexes {
    (provider, provider_payment_id) [unique]
    // В PostgreSQL: (order_id, created_at DESC, id DESC).
    (order_id, created_at, id) [name: 'payments_order_created_idx', note: 'В миграции: created_at DESC, id DESC']
  }

  // КРИТИЧЕСКИЙ частичный UNIQUE-индекс PostgreSQL: DBML не передаёт WHERE.
  // CREATE UNIQUE INDEX payments_one_active_per_order_idx
  // ON payments (order_id) WHERE status IN ('created', 'pending');
  // Без него БД не гарантирует максимум один активный платёж на заказ.
}

// Связи: дочерняя колонка > родительский PK (многие к одному).
// Для 1:1 используется "-"; ВАЖНО: справа от "-" стоит FK.

Ref: products.category_id > categories.id [delete: restrict]
Ref: product_images.product_id > products.id [delete: cascade]
Ref: carts.user_id > users.id [delete: cascade]
Ref: cart_items.cart_id > carts.id [delete: cascade]
Ref: cart_items.product_id > products.id [delete: restrict]
Ref: orders.user_id > users.id [delete: restrict]
Ref: order_items.order_id > orders.id [delete: restrict]
Ref: order_items.product_id > products.id [delete: restrict]
Ref: orders.id - deliveries.order_id [delete: restrict]
Ref: payments.order_id > orders.id [delete: restrict]

// Группы только для удобного расположения таблиц на диаграмме.
TableGroup accounts {
  users
}

TableGroup catalog {
  categories
  products
  product_images
}

TableGroup shopping_cart {
  carts
  cart_items
}

TableGroup checkout {
  orders
  order_items
  deliveries
  payments
}
